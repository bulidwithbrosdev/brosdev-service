{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/submit/:formKey",
      "destination": "/api/index?__path=/submit/:formKey"
    },
    {
      "source": "/embed/:formKey",
      "destination": "/api/index?__path=/embed/:formKey"
    },
    {
      "source": "/embed.js",
      "destination": "/api/index?__path=/embed.js"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/index?__path=/r/:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/campaigns",
      "schedule": "0 9 * * *"
    }
  ]
}
