{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/submit/:formKey",
      "destination": "/api/submit/:formKey"
    },
    {
      "source": "/embed/:formKey",
      "destination": "/api/embed/:formKey"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
