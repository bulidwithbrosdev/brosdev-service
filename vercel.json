{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/submit/:formKey",
      "destination": "/api/submit/:formKey"
    },
    {
      "source": "/embed/:formKey",
      "destination": "/api/embed/:formKey"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/r/:slug"
    },
    {
      "source": "/api/newsletter/:listKey/subscribe",
      "destination": "/api/newsletter/:listKey"
    },
    {
      "source": "/api/billing/razorpay/webhook",
      "destination": "/api/billing/razorpay-webhook"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
