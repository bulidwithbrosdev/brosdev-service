{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/submit/:formKey",
      "destination": "/api/submit/:formKey"
    },
    {
      "source": "/embed/:formKey",
      "destination": "/api/embed/:formKey"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/r/:slug"
    },
    {
      "source": "/api/billing/razorpay/webhook",
      "destination": "/api/billing/razorpay-webhook"
    },
    {
      "source": "/embed.js",
      "destination": "/api/widgets/embed"
    },
    {
      "source": "/api/widgets/embed.js",
      "destination": "/api/widgets/embed"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/campaigns",
      "schedule": "0 9 * * *"
    }
  ]
}
