# APP_URL: The public URL where BrosDev Forms is hosted (e.g., https://forms.brosdev.info).
APP_URL="https://forms.brosdev.info"

# RESEND_API_KEY: Platform owner's Resend API key for server-side email delivery (never exposed to browser).
RESEND_API_KEY=""

# ALLOWED_FRONTEND_ORIGINS: Optional comma-separated list of custom frontend origins allowed for CORS.
ALLOWED_FRONTEND_ORIGINS="https://forms.brosdev.info"

# FIREBASE_PROJECT_ID: Firebase project ID (defaults to firebase-applet-config.json).
FIREBASE_PROJECT_ID="serious-airlock-smn89"
