# APP_URL: The public URL where BrosDev Forms is hosted (e.g., https://forms.brosdev.info).
APP_URL="https://forms.brosdev.info"

# RESEND_API_KEY: Platform owner's Resend API key for server-side email delivery (never exposed to browser).
RESEND_API_KEY=""

# ENCRYPTION_KEY: Optional 32+ char secret for sealing public form email-routing tokens (falls back to RESEND_API_KEY if unset).
ENCRYPTION_KEY=""

# ALLOWED_FRONTEND_ORIGINS: Optional comma-separated list of custom frontend origins allowed for CORS.
ALLOWED_FRONTEND_ORIGINS="https://forms.brosdev.info"

# FIREBASE_PROJECT_ID: Firebase project ID (defaults to firebase-applet-config.json).
FIREBASE_PROJECT_ID="serious-airlock-smn89"

# RAZORPAY_KEY_ID: Optional Razorpay Key ID (live/test) if enabling external Razorpay gateway alongside BrosDev Pay.
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Optional server-side Razorpay Key Secret for order & signature verification (never expose to browser).
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: Optional server-side Razorpay webhook signing secret for /api/billing/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=""
