# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ENCRYPTION_KEY: 32-byte hex or passphrase used to encrypt Resend API keys and TOTP secrets at rest.
ENCRYPTION_KEY=""

# SESSION_SECRET: Secret key used to sign email/password Bearer authentication tokens.
SESSION_SECRET=""

# RESEND_API_KEY: Optional fallback Resend API key if not configured in Super Admin -> Resend Configuration.
RESEND_API_KEY=""

# RESEND_WEBHOOK_SECRET: Signing secret from Resend Webhooks (Svix) to verify delivery/bounce events.
RESEND_WEBHOOK_SECRET=""

# SUPER_ADMIN_EMAIL: Initial platform Super Admin email address.
SUPER_ADMIN_EMAIL=""

# DATABASE_URL: PostgreSQL connection string for Vercel / Supabase / Neon deployments (optional if SQL_HOST is used).
DATABASE_URL=""

# VITE_API_BASE_URL: Optional backend API origin if the frontend is hosted on a separate domain.
VITE_API_BASE_URL=""

# ALLOWED_FRONTEND_ORIGINS: Optional comma-separated list of custom frontend origins permitted for CORS.
ALLOWED_FRONTEND_ORIGINS="https://forms.brosdev.info"
