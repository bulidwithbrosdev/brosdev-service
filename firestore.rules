        && (
          isAdmin()
          || (isSignedIn() && incoming().ownerUid == request.auth.uid)
          || (
            'campaignId' in incoming()
            && isValidId(incoming().campaignId)
            && incoming().reason in ['unsubscribed', 'hard_bounce', 'spam_complaint']
            && exists(/databases/$(database)/documents/email_campaigns/$(incoming().campaignId))
            && get(/databases/$(database)/documents/email_campaigns/$(incoming().campaignId)).data.ownerUid == incoming().ownerUid
          )
        );
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(suppressionId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // 39. Email Sender Domains Collection
    match /email_sender_domains/{domainId} {
      allow get: if isSignedIn() && isValidId(domainId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(domainId)
        && isValidEmailSenderDomain(incoming())
        && incoming().id == domainId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().ownerUid == request.auth.uid);
      allow update: if isSignedIn()
        && isValidId(domainId)
        && isValidEmailSenderDomain(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'resendDomainId', 'status', 'region', 'dnsRecords', 'lastCheckedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(domainId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // 40. Email Sender Settings Collection (1 doc per workspace ownerUid)
    match /email_sender_settings/{ownerUid} {
      allow get: if isSignedIn() && isValidId(ownerUid) && (isOwner(ownerUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(ownerUid)
        && isValidEmailSenderSettings(incoming())
        && incoming().ownerUid == ownerUid
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isOwner(ownerUid) && incoming().campaignSuspended == false)
        );
      allow update: if isSignedIn()
        && isValidId(ownerUid)
        && isValidEmailSenderSettings(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(ownerUid)
            && incoming().campaignSuspended == existing().campaignSuspended
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'senderName', 'senderEmail', 'replyTo', 'companyName', 'companyWebsite',
              'companyLogoUrl', 'companyAddress', 'defaultFooter', 'additionalIdentities',
              'doubleOptInDefault', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(ownerUid);
    }

    // 41. Monthly Email Campaign Usage Counters
    match /email_campaign_usage/{usageId} {
      allow get: if isSignedIn() && isValidId(usageId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(usageId)
        && isValidEmailCampaignUsage(incoming())
        && incoming().id == usageId
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().ownerUid == request.auth.uid);
      allow update: if isSignedIn()
        && isValidId(usageId)
        && isValidEmailCampaignUsage(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().monthKey == existing().monthKey
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && incoming().emailsSent >= existing().emailsSent
            && incoming().campaignsSent >= existing().campaignsSent
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'emailsSent', 'campaignsSent', 'bounces', 'complaints', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(usageId);
    }

    // 42. Resend Webhook Audit Events (Idempotent Ledger)
    match /email_webhook_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(eventId)
        && isValidEmailWebhookEvent(incoming())
        && incoming().id == eventId
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (isSignedIn() && incoming().ownerUid == request.auth.uid)
          || (
            exists(/databases/$(database)/documents/email_campaigns/$(incoming().campaignId))
            && get(/databases/$(database)/documents/email_campaigns/$(incoming().campaignId)).data.ownerUid == incoming().ownerUid
          )
        );
      allow update: if false;
      allow delete: if isAdmin() && isValidId(eventId);
    }
  }
}
