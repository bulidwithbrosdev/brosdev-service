rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'gajjars614@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedSuperAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true);
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isBoundedNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    // Validation Blueprints (Anti-Update-Gap)
    function isValidUser(data) {
      return data.keys().hasAll([
          'uid', 'numericId', 'email', 'displayName', 'photoUrl', 'status',
          'planId', 'billingCycle', 'subscriptionStatus', 'currentPeriodStart',
          'currentPeriodEnd', 'cancelAtPeriodEnd', 'provider', 'authProvider',
          'hasPassword', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'accountId', 'numericId', 'email', 'displayName', 'photoUrl', 'status',
          'planId', 'billingCycle', 'subscriptionStatus', 'currentPeriodStart',
          'currentPeriodEnd', 'cancelAtPeriodEnd', 'provider', 'customMaxForms',
          'customMaxSubmissions', 'customMaxEmails', 'authProvider', 'hasPassword',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && (!('accountId' in data) || (data.accountId is string && data.accountId.size() >= 4 && data.accountId.size() <= 32 && data.accountId.matches('^[a-z0-9_\\-]+$')))
        && data.numericId is number
        && isBoundedNonEmptyString(data.email, 254)
        && isBoundedString(data.displayName, 120)
        && isBoundedString(data.photoUrl, 500)
        && data.status in ['active', 'suspended']
        && data.planId is number && data.planId >= 1
        && data.billingCycle in ['monthly', 'yearly']
        && data.subscriptionStatus in ['active', 'canceled', 'trialing']
        && isBoundedString(data.currentPeriodStart, 64)
        && isBoundedString(data.currentPeriodEnd, 64)
        && data.cancelAtPeriodEnd is bool
        && isBoundedString(data.provider, 40)
        && (!('customMaxForms' in data) || data.customMaxForms == null || (data.customMaxForms is number && data.customMaxForms >= 0))
        && (!('customMaxSubmissions' in data) || data.customMaxSubmissions == null || (data.customMaxSubmissions is number && data.customMaxSubmissions >= 0))
        && (!('customMaxEmails' in data) || data.customMaxEmails == null || (data.customMaxEmails is number && data.customMaxEmails >= 0))
        && data.authProvider in ['email', 'google']
        && data.hasPassword is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'roleSlug', 'roleName',
          'permissions', 'isActive', 'totpEnabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'roleSlug', 'roleName',
          'permissions', 'isActive', 'totpEnabled', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isBoundedNonEmptyString(data.email, 254)
        && isBoundedString(data.displayName, 120)
        && data.roleSlug in ['super_admin', 'admin', 'support']
        && isBoundedNonEmptyString(data.roleName, 64)
        && data.permissions is list && data.permissions.size() <= 30
        && (data.permissions.size() == 0 || data.permissions[0] is string)
        && data.isActive is bool
        && data.totpEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidForm(data) {
      return data.keys().hasAll([
          'id', 'formKey', 'ownerUid', 'userId', 'title', 'description',
          'fields', 'status', 'successMessage', 'redirectUrl', 'allowedDomains',
          'spamProtection', 'secretApiKeyPrefix', 'secretApiKeyHash', 'emailConfig',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'formKey', 'ownerUid', 'userId', 'title', 'description',
          'fields', 'status', 'successMessage', 'redirectUrl', 'allowedDomains',
          'spamProtection', 'secretApiKeyPrefix', 'secretApiKeyHash', 'emailConfig',
          'removeBranding', 'webhookUrl', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.formKey) && data.formKey.size() <= 64
        && isValidId(data.ownerUid)
        && data.userId is number
        && isBoundedNonEmptyString(data.title, 160)
        && isBoundedString(data.description, 1000)
        && data.fields is list && data.fields.size() <= 100
        && (data.fields.size() == 0 || data.fields[0] is map)
        && data.status in ['draft', 'published', 'inactive', 'suspended']
        && isBoundedString(data.successMessage, 500)
        && isBoundedString(data.redirectUrl, 500)
        && data.allowedDomains is list && data.allowedDomains.size() <= 50
        && (data.allowedDomains.size() == 0 || data.allowedDomains[0] is string)
        && data.spamProtection is map
        && isBoundedString(data.secretApiKeyPrefix, 64)
        && isBoundedString(data.secretApiKeyHash, 128)
        && data.emailConfig is map
        && (!('removeBranding' in data) || data.removeBranding is bool)
        && (!('webhookUrl' in data) || isBoundedString(data.webhookUrl, 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicForm(data) {
      return data.keys().hasAll([
          'formKey', 'formId', 'formDocId', 'ownerUid', 'title',
          'status', 'successMessage', 'redirectUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'formKey', 'formId', 'formDocId', 'ownerUid', 'title', 'description',
          'fields', 'status', 'successMessage', 'redirectUrl', 'allowedDomains',
          'spamProtection', 'secretApiKeyHash', 'routingToken', 'routingKeyId',
          'removeBranding', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.formKey) && data.formKey.size() <= 64
        && data.formId is number
        && isValidId(data.formDocId)
        && isValidId(data.ownerUid)
        && isBoundedNonEmptyString(data.title, 160)
        && (!('description' in data) || isBoundedString(data.description, 1000))
        && (!('fields' in data) || (data.fields is list && data.fields.size() <= 100 && (data.fields.size() == 0 || data.fields[0] is map)))
        && data.status in ['draft', 'published', 'inactive', 'suspended']
        && isBoundedString(data.successMessage, 500)
        && isBoundedString(data.redirectUrl, 500)
        && (!('allowedDomains' in data) || (data.allowedDomains is list && data.allowedDomains.size() <= 50 && (data.allowedDomains.size() == 0 || data.allowedDomains[0] is string)))
        && (!('spamProtection' in data) || data.spamProtection is map)
        && (!('secretApiKeyHash' in data) || isBoundedString(data.secretApiKeyHash, 128))
        && (!('routingToken' in data) || isBoundedString(data.routingToken, 8000))
        && (!('routingKeyId' in data) || isBoundedString(data.routingKeyId, 32))
        && (!('removeBranding' in data) || data.removeBranding is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll([
          'id', 'formId', 'formDocId', 'formKey', 'formTitle', 'ownerUid',
          'payload', 'files', 'isRead', 'status', 'emailDeliveryStatus',
          'sourceIp', 'originDomain', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'formId', 'formDocId', 'formKey', 'formTitle', 'ownerUid',
          'payload', 'files', 'isRead', 'status', 'emailDeliveryStatus',
          'sourceIp', 'originDomain', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && data.formId is number
        && isValidId(data.formDocId)
        && isValidId(data.formKey) && data.formKey.size() <= 64
        && isBoundedString(data.formTitle, 160)
        && isValidId(data.ownerUid)
        && data.payload is map
        && data.files is list && data.files.size() <= 10
        && (data.files.size() == 0 || data.files[0] is map)
        && data.isRead is bool
        && data.status in ['received', 'spam', 'failed']
        && data.emailDeliveryStatus in ['pending', 'accepted', 'delivered', 'bounced', 'failed', 'disabled']
        && isBoundedString(data.sourceIp, 64)
        && isBoundedString(data.originDomain, 255)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'formId', 'recipient', 'sender', 'subject',
          'status', 'resendMessageId', 'errorMessage', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'formId', 'submissionId', 'recipient', 'sender', 'subject',
          'status', 'resendMessageId', 'errorMessage', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.ownerUid)
        && data.formId is number
        && (!('submissionId' in data) || data.submissionId == null || data.submissionId is number)
        && isBoundedNonEmptyString(data.recipient, 254)
        && isBoundedString(data.sender, 254)
        && isBoundedString(data.subject, 300)
        && data.status in ['pending', 'sent', 'delivered', 'bounced', 'failed']
        && isBoundedString(data.resendMessageId, 128)
        && isBoundedString(data.errorMessage, 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlan(data) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'audienceLabel', 'description',
          'monthlyPriceCents', 'yearlyPriceCents', 'trialDays',
          'maxForms', 'maxSubmissionsPerMonth', 'maxEmailsPerMonth',
          'maxApiRequestsPerMin', 'maxStorageMb', 'features',
          'isActive', 'isArchived', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'name', 'audienceLabel', 'description',
          'monthlyPriceCents', 'yearlyPriceCents', 'trialDays',
          'maxForms', 'maxSubmissionsPerMonth', 'maxEmailsPerMonth',
          'maxApiRequestsPerMin', 'maxStorageMb',
          'maxProjects', 'maxApiKeys', 'maxWebhooks',
          'maxNewsletterLists', 'maxSubscribers', 'maxShortLinks', 'maxTeamSeats', 'maxWidgets',
          'maxCampaignEmailsPerMonth',
          'features',
          'isActive', 'isArchived', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.slug) && data.slug.size() <= 64
        && isBoundedNonEmptyString(data.name, 80)
        && isBoundedString(data.audienceLabel, 160)
        && isBoundedString(data.description, 500)
        && data.monthlyPriceCents is number && data.monthlyPriceCents >= 0
        && data.yearlyPriceCents is number && data.yearlyPriceCents >= 0
        && data.trialDays is number && data.trialDays >= 0
        && data.maxForms is number && data.maxForms >= 0
        && data.maxSubmissionsPerMonth is number && data.maxSubmissionsPerMonth >= 0
        && data.maxEmailsPerMonth is number && data.maxEmailsPerMonth >= 0
        && data.maxApiRequestsPerMin is number && data.maxApiRequestsPerMin >= 0
        && data.maxStorageMb is number && data.maxStorageMb >= 0
        && (!('maxProjects' in data) || (data.maxProjects is number && data.maxProjects >= 0))
        && (!('maxApiKeys' in data) || (data.maxApiKeys is number && data.maxApiKeys >= 0))
        && (!('maxWebhooks' in data) || (data.maxWebhooks is number && data.maxWebhooks >= 0))
        && (!('maxNewsletterLists' in data) || (data.maxNewsletterLists is number && data.maxNewsletterLists >= 0))
        && (!('maxSubscribers' in data) || (data.maxSubscribers is number && data.maxSubscribers >= 0))
        && (!('maxShortLinks' in data) || (data.maxShortLinks is number && data.maxShortLinks >= 0))
        && (!('maxTeamSeats' in data) || (data.maxTeamSeats is number && data.maxTeamSeats >= 0))
        && (!('maxWidgets' in data) || (data.maxWidgets is number && data.maxWidgets >= 0))
        && (!('maxCampaignEmailsPerMonth' in data) || (data.maxCampaignEmailsPerMonth is number && data.maxCampaignEmailsPerMonth >= 0))
        && data.features is map
        && data.isActive is bool
        && data.isArchived is bool
        && data.sortOrder is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'userId', 'customerEmail', 'planId', 'planName',
          'billingCycle', 'amountCents', 'currency', 'provider', 'providerPaymentId',
          'status', 'refundStatus', 'paymentMethod', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'userId', 'customerEmail', 'planId', 'planName',
          'billingCycle', 'amountCents', 'currency', 'provider', 'providerPaymentId',
          'status', 'refundStatus', 'paymentMethod', 'cardBrand', 'last4',
          'cardholderName', 'billingZip', 'upiId', 'bankName', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.ownerUid)
        && data.userId is number
        && isBoundedNonEmptyString(data.customerEmail, 254)
        && data.planId is number
        && isBoundedNonEmptyString(data.planName, 80)
        && data.billingCycle in ['monthly', 'yearly']
        && data.amountCents is number && data.amountCents >= 0
        && isBoundedNonEmptyString(data.currency, 8)
        && isBoundedNonEmptyString(data.provider, 40)
        && isBoundedNonEmptyString(data.providerPaymentId, 128)
        && data.status in ['succeeded', 'failed', 'refunded']
        && data.refundStatus in ['none', 'refunded']
        && isBoundedNonEmptyString(data.paymentMethod, 40)
        && (!('cardBrand' in data) || isBoundedString(data.cardBrand, 40))
        && (!('last4' in data) || isBoundedString(data.last4, 4))
        && (!('cardholderName' in data) || isBoundedString(data.cardholderName, 120))
        && (!('billingZip' in data) || isBoundedString(data.billingZip, 24))
        && (!('upiId' in data) || isBoundedString(data.upiId, 120))
        && (!('bankName' in data) || isBoundedString(data.bankName, 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll([
          'id', 'invoiceNumber', 'ownerUid', 'userId', 'customerEmail',
          'customerName', 'planName', 'billingCycle', 'planDescription',
          'amountCents', 'currency', 'status', 'periodStart', 'periodEnd',
          'issuedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'invoiceNumber', 'ownerUid', 'userId', 'customerEmail',
          'customerName', 'paymentId', 'planName', 'billingCycle', 'planDescription',
          'amountCents', 'currency', 'status', 'periodStart', 'periodEnd',
          'issuedAt', 'paymentSnapshot', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isBoundedNonEmptyString(data.invoiceNumber, 64)
        && isValidId(data.ownerUid)
        && data.userId is number
        && isBoundedNonEmptyString(data.customerEmail, 254)
        && isBoundedString(data.customerName, 120)
        && (!('paymentId' in data) || data.paymentId == null || data.paymentId is number)
        && isBoundedNonEmptyString(data.planName, 80)
        && data.billingCycle in ['monthly', 'yearly']
        && isBoundedString(data.planDescription, 500)
        && data.amountCents is number && data.amountCents >= 0
        && isBoundedNonEmptyString(data.currency, 8)
        && data.status in ['paid', 'void', 'refunded']
        && isBoundedString(data.periodStart, 64)
        && isBoundedString(data.periodEnd, 64)
        && isBoundedString(data.issuedAt, 64)
        && (!('paymentSnapshot' in data) || data.paymentSnapshot == null || data.paymentSnapshot is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['key', 'value', 'updatedAt'])
        && data.keys().hasOnly(['key', 'value', 'updatedAt'])
        && isValidId(data.key) && data.key.size() <= 64
        && data.value is map
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.id is number
        && isValidId(data.actorUid)
        && isBoundedNonEmptyString(data.actorEmail, 254)
        && isBoundedNonEmptyString(data.action, 120)
        && isBoundedNonEmptyString(data.targetType, 64)
        && isBoundedString(data.targetId, 128)
        && isBoundedString(data.details, 1000)
        && data.createdAt is timestamp;
    }

    function isValidApiUsageLog(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'endpoint', 'method', 'statusCode', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'formId', 'endpoint', 'method', 'statusCode', 'createdAt'])
        && data.id is number
        && isValidId(data.ownerUid)
        && (!('formId' in data) || data.formId == null || data.formId is number)
        && isBoundedNonEmptyString(data.endpoint, 200)
        && isBoundedNonEmptyString(data.method, 16)
        && data.statusCode is number && data.statusCode >= 100 && data.statusCode <= 599
        && data.createdAt is timestamp;
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'accountId', 'memberEmail', 'memberName',
          'role', 'status', 'invitedByEmail', 'inviteToken', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'accountId', 'memberEmail', 'memberName',
          'role', 'status', 'invitedByEmail', 'inviteToken', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.ownerUid)
        && data.accountId is string && data.accountId.size() >= 4 && data.accountId.size() <= 32 && data.accountId.matches('^[a-z0-9_\\-]+$')
        && isBoundedNonEmptyString(data.memberEmail, 254)
        && isBoundedNonEmptyString(data.memberName, 120)
        && data.role in ['admin', 'editor', 'viewer']
        && data.status in ['invited', 'active', 'revoked']
        && isBoundedNonEmptyString(data.invitedByEmail, 254)
        && isBoundedNonEmptyString(data.inviteToken, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'id', 'projectKey', 'ownerUid', 'name', 'description', 'allowedDomains',
          'verifiedDomains', 'verificationToken', 'enabledProducts', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectKey', 'ownerUid', 'name', 'description', 'allowedDomains',
          'verifiedDomains', 'verificationToken', 'enabledProducts', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.projectKey) && data.projectKey.size() <= 64
        && isValidId(data.ownerUid)
        && isBoundedNonEmptyString(data.name, 120)
        && isBoundedString(data.description, 500)
        && data.allowedDomains is list && data.allowedDomains.size() <= 30
        && (data.allowedDomains.size() == 0 || data.allowedDomains[0] is string)
        && data.verifiedDomains is list && data.verifiedDomains.size() <= 30
        && (data.verifiedDomains.size() == 0 || data.verifiedDomains[0] is string)
        && isBoundedNonEmptyString(data.verificationToken, 80)
        && data.enabledProducts is list && data.enabledProducts.size() <= 20
        && (data.enabledProducts.size() == 0 || data.enabledProducts[0] is string)
        && data.status in ['active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebhook(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'name', 'url', 'events', 'signingSecret',
          'isActive', 'lastDeliveryStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'projectKey', 'name', 'url', 'events', 'signingSecret',
          'isActive', 'lastDeliveryStatus', 'lastDeliveryAt', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.ownerUid)
        && (!('projectKey' in data) || isBoundedString(data.projectKey, 64))
        && isBoundedNonEmptyString(data.name, 120)
        && isBoundedNonEmptyString(data.url, 500)
        && data.events is list && data.events.size() >= 1 && data.events.size() <= 15
        && data.events[0] is string
        && isBoundedNonEmptyString(data.signingSecret, 128)
        && data.isActive is bool
        && data.lastDeliveryStatus in ['idle', 'succeeded', 'failed']
        && (!('lastDeliveryAt' in data) || isBoundedString(data.lastDeliveryAt, 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebhookDelivery(data) {
      return data.keys().hasAll([
          'id', 'deliveryId', 'ownerUid', 'webhookId', 'webhookName', 'targetUrl',
          'eventType', 'status', 'httpStatus', 'durationMs', 'attemptCount',
          'signature', 'responseSnippet', 'payloadSnippet', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'deliveryId', 'ownerUid', 'webhookId', 'webhookName', 'targetUrl',
          'eventType', 'status', 'httpStatus', 'durationMs', 'attemptCount',
          'signature', 'responseSnippet', 'payloadSnippet', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.deliveryId) && data.deliveryId.size() <= 64
        && isValidId(data.ownerUid)
        && data.webhookId is number
        && isBoundedString(data.webhookName, 120)
        && isBoundedNonEmptyString(data.targetUrl, 500)
        && isBoundedNonEmptyString(data.eventType, 80)
        && data.status in ['succeeded', 'failed']
        && data.httpStatus is number && data.httpStatus >= 0 && data.httpStatus <= 599
        && data.durationMs is number && data.durationMs >= 0
        && data.attemptCount is number && data.attemptCount >= 1
        && isBoundedString(data.signature, 200)
        && isBoundedString(data.responseSnippet, 500)
        && isBoundedString(data.payloadSnippet, 2000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApiKey(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'name', 'keyPrefix', 'keyHash',
          'permissions', 'products', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'projectKey', 'name', 'keyPrefix', 'keyHash',
          'permissions', 'products', 'status', 'lastUsedAt', 'createdAt', 'updatedAt'
        ])
        && data.id is number
        && isValidId(data.ownerUid)
        && (!('projectKey' in data) || isBoundedString(data.projectKey, 64))
        && isBoundedNonEmptyString(data.name, 120)
        && isBoundedNonEmptyString(data.keyPrefix, 32)
        && isBoundedNonEmptyString(data.keyHash, 128)
        && data.permissions is list && data.permissions.size() >= 1 && data.permissions.size() <= 10
        && data.permissions[0] is string
        && data.products is list && data.products.size() >= 1 && data.products.size() <= 15
        && data.products[0] is string
        && data.status in ['active', 'revoked']
        && (!('lastUsedAt' in data) || isBoundedString(data.lastUsedAt, 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNewsletterList(data) {
      return data.keys().hasAll([
          'id', 'listKey', 'ownerUid', 'name', 'description',
          'doubleOptIn', 'welcomeEmailEnabled', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'listKey', 'ownerUid', 'projectKey', 'name', 'description',
          'doubleOptIn', 'welcomeEmailEnabled', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id is number
